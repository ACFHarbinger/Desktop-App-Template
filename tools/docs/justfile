# tools/docs — build the documentation site.

set shell := ["bash", "-c"]

# Build MkDocs documentation site
build:
    cd ../../backend && uv run --with mkdocs-material --with "mkdocstrings[python]" mkdocs build --config-file ../docs/mkdocs.yml

# Serve the MkDocs site locally with live reload
serve:
    cd ../../backend && uv run --with mkdocs-material --with "mkdocstrings[python]" mkdocs serve --config-file ../docs/mkdocs.yml
