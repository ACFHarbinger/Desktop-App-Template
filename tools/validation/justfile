# tools/validation — run linters and format checks across C++, backend, and GUI modules.

set shell := ["bash", "-c"]

# Run all linters
all: cpp backend gui

cpp:
    cd ../.. && (command -v clang-format >/dev/null && find src include test -name '*.cpp' -o -name '*.hpp' -o -name '*.h' | xargs clang-format --dry-run --Werror || echo "clang-format not available, skipping C++ lint")

backend:
    cd ../../backend && uv run ruff check src test && uv run ruff format --check src test

gui:
    cd ../../gui && uv run ruff check src test && uv run ruff format --check src test
