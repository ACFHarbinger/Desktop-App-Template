# tools/test — run test suites across C++, backend, and GUI modules.

set shell := ["bash", "-c"]

# Run all test suites
all: cpp backend gui

cpp:
    cd ../.. && cmake -S . -B build -DBUILD_TESTING=ON && cmake --build build -j && ctest --test-dir build --output-on-failure

backend:
    cd ../../backend && uv run pytest test -v

gui:
    cd ../../gui && uv run pytest test -v
