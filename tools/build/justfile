# tools/build — compile C++, backend, and gui modules.

set shell := ["bash", "-c"]

# Build all modules
all: cpp backend gui

cpp:
    cd ../.. && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j

backend:
    cd ../../backend && uv build

gui:
    cd ../../gui && python3 resources/generate_qrc.py && uv build
