# tools/dev — environment setup and maintenance.

set shell := ["bash", "-c"]

# Set up backend and GUI dev environments
setup:
    @echo "Setting up dev environment..."
    cd ../../backend && uv sync --all-extras --dev
    cd ../../gui && uv sync --all-extras --dev
    pip install pre-commit || true
    pre-commit install --install-hooks || echo "pre-commit not available"
    @echo "Setup complete. Run 'just test' to verify."

# Update all dependencies
update:
    @echo "Updating dependencies..."
    cd ../../backend && uv sync --upgrade
    cd ../../gui && uv sync --upgrade

# Run pre-commit hooks manually
pre-commit:
    cd ../.. && pre-commit run --all-files

# Clean build artifacts across every module
clean:
    rm -rf ../../backend/.pytest_cache ../../backend/.ruff_cache ../../backend/.mypy_cache ../../backend/**/__pycache__
    rm -rf ../../gui/.pytest_cache ../../gui/.ruff_cache ../../gui/.mypy_cache ../../gui/**/__pycache__
    rm -rf ../../build
